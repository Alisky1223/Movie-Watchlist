# EditorConfig — Movie Watchlist
# See https://editorconfig.org/ for reference
root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,jsonc,xml,csproj,props,slnx,targets}]
indent_size = 2

[*.{cs,vb}]
# Naming rules follow dotnet-naming.mdc
dotnet_naming_rule.pascal_case_class.symbols = class_symbols
dotnet_naming_rule.pascal_case_class.style = pascal_case_style
dotnet_naming_rule.pascal_case_class.severity = suggestion

dotnet_naming_style.pascal_case_style.capitalization = pascal_case

dotnet_naming_symbols.class_symbols.applicable_kinds = class,struct,interface,enum,delegate,record
dotnet_naming_symbols.class_symbols.applicable_accessibilities = public,internal,private,protected,protected_internal,private_protected

# Prefer file-scoped namespaces
dotnet_diagnostic.IDE0160.severity = warning

# Newline settings
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_members_in_anonymous_types = true

# Indentation
csharp_indent_case_content = true
csharp_indent_switch_labels = true
csharp_indent_block_contents = true
csharp_indent_braces = false

# Spacing
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_before_open_square_brackets = false
